{
  "name": "obsidian-pangu",
  "version": "2.0.3",
  "description": "A small plugin aims to add space between Chinese Characters and English Alphabet, and it is a boon for typographically compulsive people. ",
  "main": "main.js",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "node scripts/e2e/prepare.mjs && wdio run ./tests/e2e/wdio.conf.mjs",
    "dev": "rollup --config rollup.config.js -w",
    "build": "rollup --config rollup.config.js",
    "version": "auto-changelog -p && git add HISTORY.md",
    "pub": "./pub.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@eslint/json": "0.14.0",
    "@rollup/plugin-commonjs": "^15.1.0",
    "@rollup/plugin-node-resolve": "^9.0.0",
    "@rollup/plugin-typescript": "^6.0.0",
    "@types/node": "^14.14.2",
    "@types/pangu": "^3.3.0",
    "@types/prettier": "^2.7.1",
    "@wdio/cli": "9.31.1",
    "@wdio/globals": "9.31.1",
    "@wdio/local-runner": "9.31.1",
    "@wdio/mocha-framework": "9.31.1",
    "auto-changelog": "^2.3.0",
    "eslint": "9.39.3",
    "eslint-plugin-obsidianmd": "0.4.2",
    "expect-webdriverio": "6.1.0",
    "obsidian": "1.13.1",
    "rollup": "^2.32.1",
    "semver": "^7.3.5",
    "tslib": "^2.0.3",
    "typescript": "4.9.5",
    "typescript-eslint": "8.70.0",
    "wdio-obsidian-reporter": "3.2.1",
    "wdio-obsidian-service": "3.2.1",
    "webdriverio": "9.31.1"
  },
  "dependencies": {
    "fast-diff": "1.3.0",
    "prettier": "^2.7.1"
  }
}
